<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Agent.master.cs" Inherits="Telkom.Agent" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>TelkomX Agent Portal</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    
    <!-- Common Agent Styles -->
    <style>
        :root {
            --telkom-primary: #6366f1;
            --telkom-secondary: #8b5cf6;
            --telkom-success: #10b981;
            --telkom-warning: #f59e0b;
            --telkom-error: #ef4444;
            --telkom-white: #ffffff;
            --telkom-light-gray: #f8fafc;
            --telkom-medium-gray: #e2e8f0;
            --telkom-dark-gray: #64748b;
            --telkom-text: #1e293b;
            --telkom-border: #e2e8f0;
            --agent-blue: #3b82f6;
            --agent-dark: #1e40af;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--telkom-light-gray);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .agent-header {
            background: linear-gradient(135deg, var(--agent-blue) 0%, var(--agent-dark) 100%);
            color: white;
            padding: 1rem 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .agent-badge {
            background: rgba(255,255,255,0.2);
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .notification-bell {
            position: relative;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 50%;
            transition: background-color 0.2s;
        }

        .notification-bell:hover {
            background: rgba(255,255,255,0.1);
        }

        .notification-count {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--telkom-error);
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .agent-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .agent-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .user-menu {
            position: relative;
            display: inline-block;
        }

        .user-menu-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background: white;
            min-width: 200px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
            border-radius: 8px;
            padding: 0.5rem 0;
            z-index: 1000;
        }

        .user-menu:hover .user-menu-content {
            display: block;
        }

        .menu-item {
            display: block;
            padding: 0.75rem 1rem;
            color: var(--telkom-text);
            text-decoration: none;
            transition: background-color 0.2s;
        }

        .menu-item:hover {
            background: var(--telkom-light-gray);
        }

        .main-container {
            flex: 1;
            display: flex;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            min-height: calc(100vh - 80px);
        }

        .sidebar {
            width: 260px;
            background: var(--telkom-white);
            border-right: 1px solid var(--telkom-border);
            padding: 2rem 0;
            position: sticky;
            top: 80px;
            height: fit-content;
            max-height: calc(100vh - 80px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 2rem;
        }

        .nav-title {
            padding: 0 1.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--telkom-dark-gray);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .nav-item {
            display: block;
            padding: 0.875rem 1.5rem;
            color: var(--telkom-text);
            text-decoration: none;
            transition: all 0.2s;
            border-left: 3px solid transparent;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .nav-item:hover {
            background: var(--telkom-light-gray);
            border-left-color: var(--agent-blue);
        }

        .nav-item.active {
            background: rgba(59, 130, 246, 0.1);
            border-left-color: var(--agent-blue);
            color: var(--agent-blue);
            font-weight: 600;
        }

        .nav-icon {
            font-size: 1.25rem;
        }

        .content-area {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--telkom-border);
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--telkom-text);
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            color: var(--telkom-dark-gray);
            font-size: 1.1rem;
        }

        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--telkom-success);
            color: white;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* Quick Stats Bar */
        .quick-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid var(--telkom-border);
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--agent-blue);
        }

        .stat-label {
            color: var(--telkom-dark-gray);
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        @media (max-width: 1024px) {
            .main-container {
                flex-direction: column;
            }
            
            .sidebar {
                width: 100%;
                position: static;
                height: auto;
                max-height: none;
            }
            
            .header-content {
                padding: 0 1rem;
            }
            
            .content-area {
                padding: 1rem;
            }
        }

        @media (max-width: 768px) {
            .agent-info span {
                display: none;
            }
            
            .header-actions {
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true">
        </asp:ScriptManager>
        
        <!-- Agent Header -->
        <header class="agent-header">
            <div class="header-content">
                <div class="logo-section">
                    <div class="logo">TelkomX</div>
                    <div class="agent-badge">Agent Portal</div>
                </div>
                
                <div class="header-actions">
                    <div class="status-indicator">
                        <div class="status-dot"></div>
                        Online
                    </div>
                    
                    <div class="notification-bell" onclick="toggleNotifications()">
                        <span style="font-size: 1.25rem;">🔔</span>
                        <div class="notification-count">3</div>
                    </div>
                    
                    <div class="user-menu">
                        <div class="agent-info">
                            <div class="agent-avatar">
                                <asp:Literal ID="litAgentInitials" runat="server" Text="AG" />
                            </div>
                            <span>
                                <asp:Literal ID="litAgentName" runat="server" Text="Agent User" />
                            </span>
                        </div>
                        <div class="user-menu-content">
                            <a href="#" class="menu-item">Profile Settings</a>
                            <a href="#" class="menu-item">Performance Dashboard</a>
                            <a href="#" class="menu-item">Training Resources</a>
                            <hr style="margin: 0.5rem 0; border: none; border-top: 1px solid var(--telkom-border);">
                            <asp:LinkButton ID="lnkLogout" runat="server" CssClass="menu-item" OnClick="lnkLogout_Click">
                                Logout
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <div class="main-container">
            <!-- Sidebar Navigation -->
            <nav class="sidebar">
                <div class="nav-section">
                    <div class="nav-title">Queue Management</div>
                    <a href="AgentDashboard.aspx" class="nav-item" id="navDashboard">
                        <span class="nav-icon">📊</span>
                        Dashboard
                    </a>
                    <a href="QueueManagement.aspx" class="nav-item" id="navQueue">
                        <span class="nav-icon">📋</span>
                        Live Queue
                    </a>
                    <a href="PredictiveDiagnostics.aspx" class="nav-item" id="navDiagnostics">
                        <span class="nav-icon">🔮</span>
                        Predictive Tools
                    </a>
                </div>
                
            </nav>

            <!-- Content Area -->
            <main class="content-area">
                <!-- Quick Stats (shown on all pages) -->
                <div class="quick-stats">
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litMyQueue" runat="server" Text="5" />
                        </div>
                        <div class="stat-label">Assigned to Me</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litTotalQueue" runat="server" Text="23" />
                        </div>
                        <div class="stat-label">Total in Queue</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litAvgResponse" runat="server" Text="2.3" />
                        </div>
                        <div class="stat-label">Avg Response (min)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litResolvedToday" runat="server" Text="12" />
                        </div>
                        <div class="stat-label">Resolved Today</div>
                    </div>
                </div>

                <!-- Page Content -->
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>

        <!-- Notification Panel -->
        <div id="notificationPanel" style="display: none; position: fixed; top: 80px; right: 20px; width: 300px; background: white; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); z-index: 1001; padding: 1rem;">
            <h3 style="margin-bottom: 1rem; color: var(--telkom-text);">Recent Notifications</h3>
            <div class="notification-item" style="padding: 0.75rem; border-bottom: 1px solid var(--telkom-border); font-size: 0.875rem;">
                <strong>New high-priority ticket</strong><br>
                <span style="color: var(--telkom-dark-gray);">Customer reporting connection issues</span>
            </div>
            <div class="notification-item" style="padding: 0.75rem; border-bottom: 1px solid var(--telkom-border); font-size: 0.875rem;">
                <strong>Queue assignment</strong><br>
                <span style="color: var(--telkom-dark-gray);">3 new customers assigned to you</span>
            </div>
            <div class="notification-item" style="padding: 0.75rem; font-size: 0.875rem;">
                <strong>System update</strong><br>
                <span style="color: var(--telkom-dark-gray);">Diagnostic tools updated</span>
            </div>
        </div>
    </form>

    <script type="text/javascript">
        // Set active navigation item based on current page
        document.addEventListener('DOMContentLoaded', function() {
            var currentPage = window.location.pathname.split('/').pop();
            var navItems = document.querySelectorAll('.nav-item');
            
            navItems.forEach(function(item) {
                item.classList.remove('active');
                if (item.getAttribute('href') === currentPage) {
                    item.classList.add('active');
                }
            });

            // Default to dashboard if no match
            if (currentPage === '' || currentPage === 'AgentDashboard.aspx') {
                document.getElementById('navDashboard').classList.add('active');
            }
        });

        function toggleNotifications() {
            var panel = document.getElementById('notificationPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        // Close notification panel when clicking outside
        document.addEventListener('click', function(event) {
            var panel = document.getElementById('notificationPanel');
            var bell = document.querySelector('.notification-bell');
            
            if (panel.style.display === 'block' && 
                !panel.contains(event.target) && 
                !bell.contains(event.target)) {
                panel.style.display = 'none';
            }
        });

        // Auto-refresh stats every 30 seconds
        setInterval(function() {
            if (typeof __doPostBack === 'function') {
                __doPostBack('<%= Page.ClientID %>', 'refreshStats');
            }
        }, 30000);
    </script>
</body>
</html>