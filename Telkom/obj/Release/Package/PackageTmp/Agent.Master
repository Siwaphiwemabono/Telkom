<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Agent.master.cs" Inherits="Telkom.Agent" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>TelkomX Agent Portal</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Common Agent Styles -->
    <style>
        :root {
            --telkom-green: #66CC00;
            --telkom-blue: #0077CC;
            --telkom-dark-green: #4D9900;
            --telkom-white: #ffffff;
            --telkom-light-gray: #f8fafc;
            --telkom-medium-gray: #e2e8f0;
            --telkom-dark-gray: #64748b;
            --telkom-text: #1e293b;
            --telkom-border: #e2e8f0;
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: 1px solid rgba(255, 255, 255, 0.2);
            --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            --gradient-bg: linear-gradient(135deg, var(--telkom-green) 0%, var(--telkom-blue) 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: all 0.3s ease;
        }

        body {
            background: linear-gradient(135deg, #f5f7fb 0%, #e4e7eb 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--telkom-text);
            line-height: 1.6;
        }

        /* Header Styles with Glassmorphism */
        .agent-header {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            color: var(--telkom-text);
            padding: 1rem 2rem;
            box-shadow: var(--glass-shadow);
            border-bottom: var(--glass-border);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--gradient-bg);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .agent-badge {
            background: var(--glass-bg);
            backdrop-filter: blur(5px);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border: var(--glass-border);
            color: var(--telkom-green);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.2rem;
            background: var(--glass-bg);
            color: var(--telkom-green);
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            backdrop-filter: blur(5px);
            border: var(--glass-border);
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--telkom-green);
            animation: pulse 2s infinite;
            box-shadow: 0 0 10px rgba(102, 204, 0, 0.5);
        }

        @keyframes pulse {
            0%, 100% { 
                opacity: 1;
                transform: scale(1);
            }
            50% { 
                opacity: 0.7;
                transform: scale(1.2);
            }
        }

        .notification-bell {
            position: relative;
            cursor: pointer;
            padding: 0.6rem;
            border-radius: 50%;
            transition: all 0.3s ease;
            background: var(--glass-bg);
            backdrop-filter: blur(5px);
            border: var(--glass-border);
            color: var(--telkom-text);
        }

        .notification-bell:hover {
            background: rgba(102, 204, 0, 0.1);
            transform: translateY(-2px);
            color: var(--telkom-green);
        }

        .notification-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
        }

        .agent-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        .agent-info:hover {
            background: var(--glass-bg);
        }

        .agent-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--gradient-bg);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .user-menu {
            position: relative;
        }

        .user-menu-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background: var(--telkom-white);
            min-width: 220px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            border-radius: 12px;
            padding: 0.5rem 0;
            z-index: 1000;
            margin-top: 10px;
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.3);
            animation: fadeIn 0.3s ease;
        }

        .user-menu:hover .user-menu-content {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1.2rem;
            color: var(--telkom-text);
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .menu-item:hover {
            background: linear-gradient(135deg, var(--telkom-green) 0%, var(--telkom-blue) 100%);
            color: white;
            padding-left: 1.5rem;
        }

        .menu-item i {
            width: 20px;
            text-align: center;
        }

        .main-container {
            flex: 1;
            display: flex;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            min-height: calc(100vh - 80px);
            padding: 0 1rem;
        }

        /* Sidebar Styles with Glassmorphism */
        .sidebar {
            width: 280px;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            padding: 2rem 0;
            position: sticky;
            top: 80px;
            height: fit-content;
            max-height: calc(100vh - 80px);
            overflow-y: auto;
            border-right: var(--glass-border);
        }

        .nav-section {
            margin-bottom: 2rem;
        }

        .nav-title {
            padding: 0 1.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--telkom-dark-gray);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 1rem 1.5rem;
            color: var(--telkom-text);
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
            margin: 0.25rem 0;
        }

        .nav-item:hover {
            background: rgba(102, 204, 0, 0.1);
            border-left-color: var(--telkom-green);
            transform: translateX(5px);
        }

        .nav-item.active {
            background: linear-gradient(135deg, rgba(102, 204, 0, 0.15) 0%, rgba(0, 119, 204, 0.1) 100%);
            border-left-color: var(--telkom-green);
            color: var(--telkom-text);
            font-weight: 600;
        }

        .nav-icon {
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
            color: var(--telkom-green);
        }

        .nav-item.active .nav-icon {
            color: var(--telkom-green);
        }

        .content-area {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: var(--glass-border);
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--telkom-text);
            margin-bottom: 0.5rem;
            background: var(--gradient-bg);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-subtitle {
            color: var(--telkom-dark-gray);
            font-size: 1.1rem;
            line-height: 1.5;
        }

        /* Quick Stats Bar with Glassmorphism */
        .quick-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .stat-card {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            padding: 1.75rem;
            border-radius: 12px;
            border: var(--glass-border);
            text-align: center;
            box-shadow: var(--glass-shadow);
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
            background: rgba(255, 255, 255, 0.15);
        }

        .stat-number {
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--telkom-green);
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 4px rgba(102, 204, 0, 0.2);
        }

        .stat-label {
            color: var(--telkom-dark-gray);
            font-size: 0.95rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Notification Panel with Glassmorphism */
        .notification-panel {
            display: none;
            position: fixed;
            top: 90px;
            right: 20px;
            width: 350px;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            box-shadow: var(--glass-shadow);
            z-index: 1001;
            padding: 1.25rem;
            border: var(--glass-border);
            animation: slideInRight 0.3s ease;
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(100px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .notification-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: var(--glass-border);
        }

        .notification-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--telkom-text);
        }

        .notification-item {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 0.75rem;
            background: rgba(255, 255, 255, 0.2);
            border-left: 4px solid var(--telkom-green);
            transition: all 0.3s ease;
        }

        .notification-item:hover {
            background: rgba(102, 204, 0, 0.1);
            transform: translateX(5px);
        }

        .notification-item strong {
            color: var(--telkom-text);
            display: block;
            margin-bottom: 0.25rem;
        }

        .notification-item span {
            color: var(--telkom-dark-gray);
            font-size: 0.9rem;
            line-height: 1.4;
        }

        /* Live Status Indicator */
        .live-status {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            padding: 0.75rem 1.25rem;
            border-radius: 25px;
            border: var(--glass-border);
            box-shadow: var(--glass-shadow);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 999;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--telkom-green);
        }

        .live-pulse {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--telkom-green);
            animation: livePulse 1.5s infinite;
        }

        @keyframes livePulse {
            0% { box-shadow: 0 0 0 0 rgba(102, 204, 0, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(102, 204, 0, 0); }
            100% { box-shadow: 0 0 0 0 rgba(102, 204, 0, 0); }
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .main-container {
                flex-direction: column;
            }
            
            .sidebar {
                width: 100%;
                position: static;
                height: auto;
                max-height: none;
                padding: 1.5rem;
            }
            
            .header-content {
                padding: 0 1rem;
            }
            
            .content-area {
                padding: 1.5rem;
            }
            
            .quick-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .agent-header {
                padding: 1rem;
            }
            
            .logo {
                font-size: 1.5rem;
            }
            
            .agent-info span {
                display: none;
            }
            
            .header-actions {
                gap: 1rem;
            }
            
            .status-indicator span {
                display: none;
            }
            
            .quick-stats {
                grid-template-columns: 1fr;
            }
            
            .notification-panel {
                width: 300px;
                right: 10px;
            }
        }

        @media (max-width: 480px) {
            .content-area {
                padding: 1rem;
            }
            
            .page-title {
                font-size: 1.8rem;
            }
            
            .stat-card {
                padding: 1.25rem;
            }
            
            .stat-number {
                font-size: 2rem;
            }
            
            .live-status {
                bottom: 10px;
                right: 10px;
                font-size: 0.8rem;
                padding: 0.5rem 1rem;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true">
        </asp:ScriptManager>
        
        <!-- Agent Header -->
        <header class="agent-header">
            <div class="header-content">
                <div class="logo-section">
                    <div class="logo">
                        <i class="fas fa-headset"></i> Telkom<span style="color: #FFD700;">X</span>
                    </div>
                    <div class="agent-badge">Agent Portal</div>
                </div>
                
                <div class="header-actions">
                    <div class="status-indicator">
                        <div class="status-dot"></div>
                        <span>Online</span>
                    </div>
                    
                    <div class="notification-bell" onclick="toggleNotifications()">
                        <i class="fas fa-bell"></i>
                        <div class="notification-count">3</div>
                    </div>
                    
                    <div class="user-menu">
                        <div class="agent-info">
                            <div class="agent-avatar">
                                <asp:Literal ID="litAgentInitials" runat="server" Text="AG" />
                            </div>
                            <span>
                                <asp:Literal ID="litAgentName" runat="server" Text="Agent User" />
                            </span>
                            <i class="fas fa-chevron-down" style="font-size: 0.8rem;"></i>
                        </div>
                        <div class="user-menu-content">
                            <a href="#" class="menu-item">
                                <i class="fas fa-user"></i>Profile Settings
                            </a>
                            <a href="#" class="menu-item">
                                <i class="fas fa-chart-line"></i>Performance Dashboard
                            </a>
                            <a href="#" class="menu-item">
                                <i class="fas fa-graduation-cap"></i>Training Resources
                            </a>
                            <hr style="margin: 0.5rem 0; border: none; border-top: 1px solid var(--telkom-border);">
                            <asp:LinkButton ID="lnkLogout" runat="server" CssClass="menu-item" OnClick="lnkLogout_Click">
                                <i class="fas fa-sign-out-alt"></i>Logout
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <div class="main-container">
            <!-- Sidebar Navigation -->
            <nav class="sidebar">
                <div class="nav-section">
                    <div class="nav-title">Queue Management</div>
                    <a href="AgentDashboard.aspx" class="nav-item" id="navDashboard">
                        <span class="nav-icon"><i class="fas fa-chart-pie"></i></span>
                        Dashboard
                    </a>
                    <a href="QueueManagement.aspx" class="nav-item" id="navQueue">
                        <span class="nav-icon"><i class="fas fa-list-alt"></i></span>
                        Live Queue
                    </a>
                    <a href="PredictiveDiagnostics.aspx" class="nav-item" id="navDiagnostics">
                        <span class="nav-icon"><i class="fas fa-magic"></i></span>
                        Predictive Tools
                    </a>
                </div>
                
                <div class="nav-section">
                    <div class="nav-title">Customer Management</div>
                 
                    <a href="PriorityBookingManagement.aspx" class="nav-item" id="navHistory">
                        <span class="nav-icon"><i class="fas fa-history"></i></span>
                        Priority Booking
                    </a>
                    <a href="TechnicianScheduling.aspx" class="nav-item" id="navKnowledge">
                        <span class="nav-icon"><i class="fas fa-book"></i></span>
                        Schedule
                    </a>
                </div>
                <ul>
                    <li class="nav-item"><a href="LandingPage.aspx" class="nav-link" id="logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </nav>'

            <!-- Content Area -->
            <main class="content-area">
                <!-- Quick Stats (shown on all pages) -->
                <div class="quick-stats">
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litMyQueue" runat="server" Text="5" />
                        </div>
                        <div class="stat-label">Assigned to Me</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litTotalQueue" runat="server" Text="23" />
                        </div>
                        <div class="stat-label">Total in Queue</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litAvgResponse" runat="server" Text="2.3" />
                        </div>
                        <div class="stat-label">Avg Response (min)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">
                            <asp:Literal ID="litResolvedToday" runat="server" Text="12" />
                        </div>
                        <div class="stat-label">Resolved Today</div>
                    </div>
                </div>

                <!-- Page Content -->
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>

        <!-- Notification Panel -->
        <div id="notificationPanel" class="notification-panel">
            <div class="notification-header">
                <h3 class="notification-title">Recent Notifications</h3>
                <i class="fas fa-times" onclick="toggleNotifications()" style="cursor: pointer; color: var(--telkom-dark-gray);"></i>
            </div>
            <div class="notification-item">
                <strong>New high-priority ticket</strong>
                <span>Customer reporting connection issues - requires immediate attention</span>
            </div>
            <div class="notification-item">
                <strong>Queue assignment</strong>
                <span>3 new customers have been assigned to your queue</span>
            </div>
            <div class="notification-item">
                <strong>System update</strong>
                <span>Diagnostic tools have been updated to version 2.3.1</span>
            </div>
            <div class="notification-item">
                <strong>Performance alert</strong>
                <span>You're exceeding your target resolution time by 15%</span>
            </div>
        </div>

        <!-- Live Status Indicator -->
        <div class="live-status">
            <div class="live-pulse"></div>
            <span>Live Updates Active</span>
        </div>
    </form>

    <script type="text/javascript">
        // Set active navigation item based on current page
        document.addEventListener('DOMContentLoaded', function () {
            var currentPage = window.location.pathname.split('/').pop();
            var navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(function (item) {
                item.classList.remove('active');
                if (item.getAttribute('href') === currentPage) {
                    item.classList.add('active');
                }
            });

            // Default to dashboard if no match
            if (currentPage === '' || currentPage === 'AgentDashboard.aspx' || currentPage === 'Default.aspx') {
                document.getElementById('navDashboard').classList.add('active');
            }

            // Add animation to stat cards
            document.querySelectorAll('.stat-card').forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
                card.classList.add('fade-in');
            });
        });

        function toggleNotifications() {
            var panel = document.getElementById('notificationPanel');
            if (panel.style.display === 'block') {
                panel.style.display = 'none';
            } else {
                panel.style.display = 'block';
            }
        }

        // Close notification panel when clicking outside
        document.addEventListener('click', function (event) {
            var panel = document.getElementById('notificationPanel');
            var bell = document.querySelector('.notification-bell');

            if (panel.style.display === 'block' &&
                !panel.contains(event.target) &&
                !bell.contains(event.target)) {
                panel.style.display = 'none';
            }
        });

        // Auto-refresh stats every 30 seconds
        setInterval(function () {
            if (typeof __doPostBack === 'function') {
                __doPostBack('<%= Page.ClientID %>', 'refreshStats');
            }
        }, 30000);

        // Simulate live updates
        setInterval(function () {
            const liveStatus = document.querySelector('.live-status');
            liveStatus.style.opacity = liveStatus.style.opacity === '0.7' ? '1' : '0.7';
        }, 2000);

        // Add keyboard shortcut for notifications (Alt+N)
        document.addEventListener('keydown', function (e) {
            if (e.altKey && e.key === 'n') {
                e.preventDefault();
                toggleNotifications();
            }
        });
    </script>
</body>
</html>