<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="TechMaster.master.cs" Inherits="Telkom.TechMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technician/Support Portal</title>
    <asp:ContentPlaceHolder ID="headContent" runat="server"></asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --telkom-blue: #0077CC;
            --telkom-green: #66CC00;
            --telkom-dark-blue: #003366;
            --telkom-white: #FFFFFF;
            --telkom-soft-white: #F5F7FB;
            --telkom-black: #0A0A0A;
            --telkom-dark-gray: #1F1F1F;
            --gradient-bg: linear-gradient(135deg, #004080 0%, #0077CC 100%);
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: 1px solid rgba(255, 255, 255, 0.3);
            --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            transition: all 0.3s ease;
        }

        body {
            background: var(--telkom-soft-white);
            color: var(--telkom-dark-gray);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            display: grid;
            grid-template-columns: 250px 1fr;
            min-height: 100vh;
            transition: grid-template-columns 0.3s;
        }

        /* Sidebar Styles */
        .sidebar {
            background: var(--gradient-bg);
            color: var(--telkom-white);
            padding: 20px 0;
            position: fixed;
            width: 250px;
            height: 100%;
            overflow-y: auto;
            z-index: 1000;
            transform: translateX(0);
            box-shadow: var(--glass-shadow);
        }

        .sidebar.closed {
            transform: translateX(-100%);
        }

        .logo {
            padding: 20px;
            border-bottom: var(--glass-border);
            margin-bottom: 20px;
            text-align: center;
        }

        .logo h1 {
            font-size: 1.8rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .logo i {
            font-size: 1.5rem;
        }

        .user-info {
            margin-bottom: 20px;
            padding: 0 20px 15px;
            border-bottom: var(--glass-border);
            text-align: center;
        }

        .user-info span {
            font-size: 1rem;
            opacity: 0.9;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
        }

        .nav-item {
            margin-bottom: 5px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: var(--telkom-white);
            text-decoration: none;
            font-weight: 600;
            gap: 12px;
            border-left: 4px solid transparent;
        }

        .nav-link:hover, .nav-link.active {
            background: rgba(255, 255, 255, 0.1);
            border-left-color: var(--telkom-green);
            transform: translateX(5px);
        }

        .nav-link i {
            font-size: 1.2rem;
        }

        /* Main Content Styles */
        .main-content {
            grid-column: 2;
            padding: 30px;
            background: var(--telkom-white);
            min-height: 100vh;
        }

        /* Header Styles */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: var(--glass-shadow);
        }

        .header h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--telkom-dark-gray);
        }

        .sidebar-toggle {
            font-size: 1.5rem;
            color: var(--telkom-dark-gray);
            cursor: pointer;
            display: none;
        }

        .user-info-header {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--telkom-blue);
            color: var(--telkom-white);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .notifications {
            position: relative;
        }

        .notifications .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--telkom-green);
            color: var(--telkom-dark-gray);
            border-radius: 50%;
            padding: 4px 8px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Content Placeholder */
        .content-placeholder {
            margin-top: 20px;
        }

        /* Button Styles */
        .btn {
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: var(--gradient-bg);
            color: var(--telkom-white);
            box-shadow: var(--glass-shadow);
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        }

        .btn-secondary {
            background: var(--telkom-green);
            color: var(--telkom-dark-gray);
            box-shadow: var(--glass-shadow);
        }

        .btn-secondary:hover {
            background: #55CC00;
            transform: scale(1.05);
        }

        /* Card Styles */
        .dashboard-card {
            background: var(--telkom-white);
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: var(--glass-shadow);
            animation: fadeIn 0.5s ease forwards;
        }

        .card-header {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--telkom-dark-blue);
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--telkom-green);
        }

        /* Table Styles */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        th {
            background: var(--telkom-blue);
            color: var(--telkom-white);
            font-weight: 600;
        }

        tr:nth-child(even) {
            background: var(--telkom-soft-white);
        }

        tr:hover {
            background: rgba(0, 119, 204, 0.1);
        }

        .alert-high {
            color: #ef4444;
            font-weight: bold;
        }

        .alert-medium {
            color: #f59e0b;
            font-weight: bold;
        }

        .alert-low {
            color: #10b981;
            font-weight: bold;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .container {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                transform: translateX(-100%);
                z-index: 2000;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-toggle {
                display: block;
            }

            .main-content {
                grid-column: 1;
                padding: 20px;
            }

            .header {
                flex-wrap: wrap;
                gap: 15px;
            }
        }

        @media (max-width: 576px) {
            .header h2 {
                font-size: 1.5rem;
            }
            
            th, td {
                padding: 10px;
                font-size: 0.9rem;
            }
            
            .btn {
                font-size: 0.9rem;
                padding: 10px 15px;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true" />
        <div class="container">
            <!-- Sidebar -->
            <aside class="sidebar" id="sidebar">
                <div class="logo">
                    <h1><i class="fas fa-tools"></i> Tech<span style="color: var(--telkom-green);">Portal</span></h1>
                </div>
                <div class="user-info">
                    <span>Welcome, <asp:Label ID="lblUsername" runat="server" Text="Technician"></asp:Label></span>
                </div>
                <ul class="nav-menu">
                    <li class="nav-item"><a href="TechnicianDashboard.aspx" class="nav-link active"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="nav-item"><a href="EscalatedQueue.aspx" class="nav-link"><i class="fas fa-exclamation-circle"></i> Escalated Cases</a></li>
                    <li class="nav-item"><a href="CommunityForumMgmt.aspx" class="nav-link"><i class="fas fa-users"></i> Community Forum</a></li>
                    <li class="nav-item">
                        <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CssClass="nav-link">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </asp:LinkButton>
                    </li>
                </ul>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <!-- Header -->
                <div class="header">
                    <span class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></span>
                    <h2>John The Technician</h2>
                    <div class="user-info-header">
                        <div class="notifications">
                            <i class="fas fa-bell"></i>
                            <span class="badge">3</span>
                        </div>
                        <div class="user-avatar">
                            <asp:Label ID="lblUserInitials" runat="server" Text="T"></asp:Label>
                        </div>
                    </div>
                </div>

                <!-- Content Placeholder -->
                <div class="content-placeholder">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        <!-- Default content if no page content is provided -->
                        <div class="dashboard-card">
                            <div class="card-header">Today's Overview</div>
                            <p>Welcome to the Technician Portal. Select an option from the sidebar to get started.</p>
                        </div>
                        
                        <div class="dashboard-card">
                            <div class="card-header">Quick Stats</div>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                                <div style="text-align: center; padding: 15px; background: var(--telkom-soft-white); border-radius: 8px;">
                                    <div style="font-size: 2rem; font-weight: bold; color: var(--telkom-blue);">12</div>
                                    <div>Open Tickets</div>
                                </div>
                                <div style="text-align: center; padding: 15px; background: var(--telkom-soft-white); border-radius: 8px;">
                                    <div style="font-size: 2rem; font-weight: bold; color: var(--telkom-blue);">5</div>
                                    <div>Escalated Cases</div>
                                </div>
                                <div style="text-align: center; padding: 15px; background: var(--telkom-soft-white); border-radius: 8px;">
                                    <div style="font-size: 2rem; font-weight: bold; color: var(--telkom-blue);">87%</div>
                                    <div>Resolution Rate</div>
                                </div>
                              
                            </div>
                        </div>
                    </asp:ContentPlaceHolder>
                </div>
            </main>
        </div>
    </form>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');

            toggle.addEventListener('click', function () {
                sidebar.classList.toggle('open');
            });

            // Set active nav link based on current page
            const currentPath = window.location.pathname;
            document.querySelectorAll('.nav-link').forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            // Set user initials
            const username = document.getElementById('<%= lblUsername.ClientID %>').textContent;
            const initials = username.split(' ').map(name => name[0]).join('').toUpperCase();
            document.getElementById('<%= lblUserInitials.ClientID %>').textContent = initials;
        });
    </script>
</body>
</html>
